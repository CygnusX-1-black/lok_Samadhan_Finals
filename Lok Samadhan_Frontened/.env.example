# Lok Samadhan Frontend Environment Configuration

# Backend API Base URL
# - Physical Mobile Device (Wi-Fi LAN): http://<YOUR_LOCAL_IP>:5000/api
# - Physical Mobile Device (USB with adb reverse): http://localhost:5000/api
# - Android Emulator: http://10.0.2.2:5000/api
# - Web & Desktop: http://localhost:5000/api
API_BASE_URL=http://localhost:5000/api
BACKEND_URL=http://localhost:5000

# Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# App Environment
ENVIRONMENT=development
